{
  "name": "cooking-tube",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Design House <hello@designhouse.me> (https://designhouse.me)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 5173",
    "dev:cloudflare": "node scripts/run-framework.mjs dev",
    "build": "next build --webpack",
    "build:cloudflare": "node scripts/run-framework.mjs build",
    "cloudflare:types": "wrangler types worker-configuration.d.ts --include-runtime false",
    "cloudflare:config": "node scripts/cloudflare-config.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "preview:cloudflare": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
