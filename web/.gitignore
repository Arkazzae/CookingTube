# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# typescript
next-env.d.ts
*.tsbuildinfo

# env files (only the template is committed)
.env*
!.env.example

# vercel
.vercel

# cloudflare / vinext build and local state
/dist/
/.vinext/
/.wrangler/

# generated by `npm run build:worker`
/public/generated/

# checkout-local execution profile and tool state; never publish them
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
